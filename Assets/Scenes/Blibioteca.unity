  m_Script: {fileID: 11500000, guid: 83189876d4d389f43b7dd2e925aa112e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 13
  json: "{\"Options\":[],\"Parameters\":[{\"__type\":\"EditableBoolParameter:#DialogueEditor\",\"ParameterName\":\"HasFoundCrystals\",\"BoolValue\":false}],\"SpeechNodes\":[{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[{\"__type\":\"EditableBoolCondition:#DialogueEditor\",\"ParameterName\":\"HasFoundCrystals\",\"CheckType\":0,\"RequiredValue\":false}],\"NodeUID\":8},{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[{\"__type\":\"EditableBoolCondition:#DialogueEditor\",\"ParameterName\":\"HasFoundCrystals\",\"CheckType\":0,\"RequiredValue\":true}],\"NodeUID\":10}],\"EditorInfo\":{\"isRoot\":true,\"xPos\":125.5,\"yPos\":-71},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Menudos
    zopencos, no pueden hacer ni m\xEDnimamente una tarea bien. Ey, buenas, \xBFte
    importar\xEDa ayudarme con una cosa?\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Encargado
    del almac\xE9n\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":9}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":5,\"yPos\":31},\"ID\":8,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Voy
    corta de tiempo pero, si puedo, te ayudar\xE9.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Viktra\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.7},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":5,\"yPos\":133},\"ID\":9,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Te
    lo agradezco, los patanes a los que les ordene que llevaran los cristales m\xE1gicos
    al almac\xE9n los han dejado por cualquier sitio y no los encuentro. Si das con
    ellos, av\xEDsame de donde est\xE1n y te recompensar\xE9 con la informaci\xF3n
    de un objeto que lord Korby quer\xEDa usar para hacerle una jugarreta al se\xF1or
    Ephraim.\",\"parentUIDs\":[8],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Encargado
    del almac\xE9n\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":11}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":232,\"yPos\":31},\"ID\":10,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"\xBFLas
    has encontrado? Menos mal que alguien no es un perezoso.\",\"parentUIDs\":[0],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Encargado
    del almac\xE9n\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75},{\"Connections\":[{\"__type\":\"EditableSpeechConnection:#DialogueEditor\",\"Conditions\":[],\"NodeUID\":12}],\"EditorInfo\":{\"isRoot\":false,\"xPos\":232,\"yPos\":131},\"ID\":11,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"No
    ha sido nada. Ahora, si me contar\xE1s lo del objeto me ayudar\xEDas mucho.\",\"parentUIDs\":[10],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Viktra\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.7},{\"Connections\":[],\"EditorInfo\":{\"isRoot\":false,\"xPos\":232,\"yPos\":232},\"ID\":12,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Es
    verdad, te lo has ganado. El objeto es un colmillo de cierta bestia, lo perdimos
    en la zona del jard\xEDn, en la zona noreste. Lo m\xE1s probable es que se lo
    comiera una de las plantas carn\xEDvoras de la zona. Necesitar\xE1s un cebo para
    qu\xE9 abra la boca; ten te lo doy, ya que no lo\",\"parentUIDs\":[11],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Encargado
    del almac\xE9n\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75}]}"
