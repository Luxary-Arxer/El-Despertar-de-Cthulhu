  m_Script: {fileID: 11500000, guid: b3411c449547dac4ba99eb6da53fcf1d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _NPCText: "Hace una semana ten\xEDamos tres conserjes, uno desapareci\xF3 limpiando
    las habitaciones de los generales, otro se asust\xF3 tanto por ello que se retir\xF3
    y el \xFAnico que queda estamos todos convencidos de que tiene los d\xEDas contados\u2026
    \xBFQui\xE9n dir\xEDa que ser conserje ser\xEDa tan duro?"
