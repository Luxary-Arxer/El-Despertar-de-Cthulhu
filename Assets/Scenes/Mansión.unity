  m_EditorClassIdentifier: 
  CurrentIDCounter: 8
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[],\"EditorInfo\":{\"isRoot\":true,\"xPos\":176.5,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Desde
    que los generales llegaron no han parado de ocurrir cosas extra\xF1as. Mi amigo
    desapareci\xF3 la semana pasada haciendo un turno de limpieza. Lo he estado buscando,
    pero lo \xFAnico que he encontrado es una nota suya que dice \u201CY al perder
    la raz\xF3n\u2026 Se aclara la visi\xF3n\u201D. Parece un santo y se\xF1a, pero
    no s\xE9 para qu\xE9\u2026 Est\xE9 donde est\xE9, espero que est\xE9 a salvo.\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Conserje
    Desolado\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75}]}"
