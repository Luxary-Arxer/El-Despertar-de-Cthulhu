  m_Name: 
  m_EditorClassIdentifier: 
  CurrentIDCounter: 8
  json: "{\"Options\":[],\"Parameters\":[],\"SpeechNodes\":[{\"Connections\":[],\"EditorInfo\":{\"isRoot\":true,\"xPos\":176.5,\"yPos\":22},\"ID\":0,\"ParamActions\":[],\"TMPFontGUID\":null,\"Text\":\"Ser
    un conserje no es cosa f\xE1cil, especialmente ahora que estoy solo. Mi anterior
    compa\xF1ero se larg\xF3 y ahora lo \xFAnico que hace es leer libros mientras
    yo me parto el lomo\u2026 Y hoy toca limpieza completa\u2026 no s\xE9 c\xF3mo
    voy a poder hacerlo en un d\xEDa. A este paso para cuando se haga de noche reci\xE9n
    empezar\xE9 con las habitaciones de los generales\u2026\",\"parentUIDs\":[],\"AdvanceDialogueAutomatically\":false,\"AudioGUID\":null,\"AutoAdvanceShouldDisplayOption\":false,\"IconGUID\":null,\"Name\":\"Conserje\",\"OptionUIDs\":null,\"SpeechUID\":0,\"TimeUntilAdvance\":0,\"Volume\":0.75}]}"
