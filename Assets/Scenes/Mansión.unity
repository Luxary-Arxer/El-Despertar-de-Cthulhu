--- !u!114 &5469685593576914848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4202525705932167450}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b3411c449547dac4ba99eb6da53fcf1d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _NPCText: "Cada vez que paso por delante de la puerta que da a la habitaci\xF3n
    de Lady Bifia, escucho siseos y ara\xF1azos. No s\xE9 qu\xE9 tienen ah\xED dentro,
    pero no me atrevo a preguntar."
