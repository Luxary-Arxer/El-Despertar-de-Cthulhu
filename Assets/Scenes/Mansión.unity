  m_Script: {fileID: 11500000, guid: b3411c449547dac4ba99eb6da53fcf1d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _NPCText: "Estaba pensando en hacerme conserje\u2026 pero despu\xE9s de hablar
    con alguien que se pasa rebuscando por el jard\xEDn, le perd\xED las ganas\u2026
    parece que est\xE1n pasando cosas extra\xF1as\u2026 y el \xFAltimo conserje que
    tenemos se pasa el d\xEDa en la mansi\xF3n trabajando, as\xED que tampoco suena
    tan bien\u2026 "
